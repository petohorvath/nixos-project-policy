{
  "schemaVersion": 1,
  "systems": ["x86_64-linux", "aarch64-linux"],
  "requiredTools": ["nix", "nil", "nixfmt", "statix", "deadnix"],
  "readmeSections": ["Support", "Quickstart", "Development", "Contributing", "Documentation"],
  "ci": {
    "callerJobName": "Policy",
    "requiredChecks": [
      "Policy / Verify policy version and load shared pins",
      "Policy / Compatibility (stable, x86_64-linux)",
      "Policy / Compatibility (stable, aarch64-linux)",
      "Policy / Compatibility (unstable, x86_64-linux)",
      "Policy / Compatibility (unstable, aarch64-linux)"
    ],
    "architectureChecks": ["Compliance", "Formatting and lint", "Project tests"],
    "runners": {
      "x86_64-linux": "ubuntu-24.04",
      "aarch64-linux": "ubuntu-24.04-arm"
    },
    "vmCheck": "Policy / VM tests (x86_64-linux)"
  }
}
